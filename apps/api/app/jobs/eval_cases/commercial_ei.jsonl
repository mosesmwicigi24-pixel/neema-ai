{"id": "cei-005", "source": "developer", "categories": ["unsuccessful-sale", "closing"], "lang": "en", "country": "KE", "critical": false, "notes": "A firm decline after a quote. Good: one gracious line, the door left open in plain words, no question, no discount, no check-back date.", "turns": [{"user": "How much is a clergy shirt?", "expect": {"next": "quote", "length_kind": "short", "forbid": ["\\bhub\\b", "our system"], "figures": "hub-only"}}, {"user": "Thanks for the info. Not for me right now.", "expect": {"said": null, "next": "answer", "length_kind": "ack", "forbid": ["is there a (day|time)", "which day", "check back", "remind you", "follow up with you", "\\?", "discount", "special offer", "% off", "alternative"], "judge": ["emotion"]}}]}
{"id": "cei-006", "source": "developer", "categories": ["price-objection", "closing"], "lang": "en", "country": "KE", "critical": false, "notes": "Comparing suppliers. Good: accept without a discount or urgency, keep the chasuble, no question.", "turns": [{"user": "How much is a chasuble?", "expect": {"next": "quote", "length_kind": "short", "forbid": ["\\bhub\\b", "our system"], "figures": "hub-only"}}, {"user": "Let me compare with other suppliers first", "expect": {"said": "comparing", "next": "hold_ack", "length_kind": "short", "forbid": ["is there a (day|time)", "which day", "check back", "remind you", "follow up with you", "\\?", "discount", "special offer", "limited", "today only"], "require": ["chasuble"]}}]}
